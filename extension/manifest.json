{
  "manifest_version": 3,
  "name": "M Download",
  "version": "1.2.0",
  "description": "Gửi link tải từ trình duyệt sang app M Download. Created by Mondiro.",
  "permissions": ["downloads", "downloads.ui", "contextMenus", "storage", "cookies", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }
  ],
  "action": {
    "default_title": "M Download",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
